# -----------------------------------------------------------------------------
# PostgreSQL-facing listener
# -----------------------------------------------------------------------------
PG_LISTEN_HOST=0.0.0.0
PG_LISTEN_PORT=5432
PG_SERVER_VERSION=14.0
PG_MAX_CLIENTS=100
PG_CLIENT_IDLE_TIMEOUT_MS=1800000
PG_MAX_FRONTEND_MESSAGE_BYTES=16777216
PG_PROTOCOL_TRACE=false
PGADMIN_SCHEMA_CACHE_MS=10000
PGADMIN_HIDE_SYSTEM_SCHEMAS=true

# Client authentication is LOCAL TO THIS PROXY. It is not an IBM i profile.
# Supported: md5Password, cleartextPassword, none
PG_AUTH_MODE=md5Password
PG_PROXY_USER=proxyuser
PG_PROXY_PASSWORD=CHANGE_ME_PROXY_PASSWORD

# Optional PostgreSQL-side TLS. If PG_TLS_ENABLED=true both files are required.
PG_TLS_ENABLED=false
PG_TLS_KEY_FILE=/app/certs/server-key.pem
PG_TLS_CERT_FILE=/app/certs/server-cert.pem
PG_TLS_CA_FILE=

# -----------------------------------------------------------------------------
# IBM i / Mapepire service account - used for ALL backend connections
# -----------------------------------------------------------------------------
IBMI_RDB_NAME=MYRDB
IBMI_HOST=ibmi.example.com
MAPEPIRE_PORT=8076
IBMI_USER=PGPROXY
IBMI_PASSWORD=CHANGE_ME_IBMI_PASSWORD
MAPEPIRE_REJECT_UNAUTHORIZED=true
# Optional PEM CA file for a private/self-signed Mapepire CA.
MAPEPIRE_CA_FILE=

# -----------------------------------------------------------------------------
# Db2 session defaults and Mapepire pool
# -----------------------------------------------------------------------------
IBMI_CURRENT_SCHEMA=MYLIB
# Backward-compatible alias; IBMI_CURRENT_SCHEMA takes precedence.
DEFAULT_SCHEMA=MYLIB
MAPEPIRE_POOL_STARTING_SIZE=4
MAPEPIRE_POOL_MAX_SIZE=12
MAPEPIRE_POOL_ACQUIRE_TIMEOUT_MS=30000
# Default 0 for correctness. Enable only when the workload is guaranteed safe to retry.
MAPEPIRE_RECONNECT_RETRIES=0
MAPEPIRE_FETCH_SIZE=500

# JDBC/Toolbox properties supported by @ibm/mapepire-js.
# auto commit=false is intentional: the proxy controls PostgreSQL transaction semantics.
MAPEPIRE_JDBC_NAMING=sql
# Optional comma-separated library list; mainly relevant with system naming/unqualified objects.
MAPEPIRE_JDBC_LIBRARIES=
MAPEPIRE_JDBC_DATE_FORMAT=iso
MAPEPIRE_JDBC_TIME_FORMAT=iso
MAPEPIRE_JDBC_DECIMAL_SEPARATOR=.
MAPEPIRE_JDBC_AUTO_COMMIT=false
MAPEPIRE_JDBC_TRANSACTION_ISOLATION=read committed
MAPEPIRE_JDBC_BLOCK_SIZE=128
MAPEPIRE_JDBC_DATA_COMPRESSION=true
MAPEPIRE_JDBC_PREFETCH=true
MAPEPIRE_JDBC_EXTENDED_METADATA=true
MAPEPIRE_JDBC_KEEP_ALIVE=true
MAPEPIRE_JDBC_QUERY_TIMEOUT_MECHANISM=cancel
MAPEPIRE_JDBC_QUERY_STORAGE_LIMIT=

# -----------------------------------------------------------------------------
# SQL compatibility / behavior
# -----------------------------------------------------------------------------
SQL_UPPERCASE_UNQUOTED_IDENTIFIERS=true
SQL_ENABLE_INFORMATION_SCHEMA_REWRITE=true
SQL_ENABLE_PG_CATALOG_COMPAT=true
SQL_ALLOW_MULTI_STATEMENT=false
SQL_MAX_ROWS=0
# PostgreSQL VARCHAR without an explicit length is mapped to this Db2 for i length.
SQL_DDL_DEFAULT_VARCHAR_LENGTH=1024
SQL_LOG_TEXT=false
SQL_LOG_FAILED_TEXT=false

# -----------------------------------------------------------------------------
# Health / operations
# -----------------------------------------------------------------------------
HEALTH_LISTEN_HOST=0.0.0.0
HEALTH_LISTEN_PORT=8080
LOG_LEVEL=info
SHUTDOWN_GRACE_MS=15000
